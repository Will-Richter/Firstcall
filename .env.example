# None of these are required to try Firstcall on your own computer.
# On a host, set PUBLIC_URL and CONTACT_EMAIL, and make sure DATA_DIR is on a disk that is kept between restarts.

# The https address people open the app at, without a trailing slash. Used in the mail link script.
PUBLIC_URL=https://firstcall.example.com

# Where the app keeps its database and its secret key. Must be a persistent disk.
DATA_DIR=/data

# The port to listen on. Most hosts set this for you.
PORT=8080

# Set to 1 when the host puts its own HTTPS proxy in front of the app, which is the usual case.
# It lets the app see each visitor's real address, which the limit on wrong passwords relies on.
TRUST_PROXY=1

# Optional. Only this email can create the first (owner) account. Worth setting if the address
# will be live for a while before you sign up.
# OWNER_EMAIL=you@example.com

# Optional. A contact address passed to Apple and Google with each notification.
# Without it, PUBLIC_URL is passed instead.
# CONTACT_EMAIL=you@example.com

# Optional. Any long random text, used to lock the stored ServiceM8 key.
# Leave it out and Firstcall creates one on the data disk the first time it starts.
# SECRET_KEY=

# Optional. Sign-ups close after the first account is created. Set to "on" to let more people create accounts.
# SIGNUPS=on
